# Environment manifest (S9-02). settings.py fails closed: ENVIRONMENT is
# required everywhere, and in production every var in the "required in
# production" block below must be set (see cloudbuild.yaml, which declares
# them for the deployed service and jobs).
#
# Local development: copy to .env or export in your shell.
#   export ENVIRONMENT=development

# --- required everywhere ---
# one of: production | development | collectstatic
ENVIRONMENT=development

# --- required in production (validated at boot) ---
#GOOGLE_CLOUD_PROJECT=my-project-id
#CLOUD_SQL_CONNECTION_NAME=my-project-id:us-east1:danielmherman-db
#ALLOWED_HOSTS=danielmherman.com,www.danielmherman.com,.run.app
#CSRF_TRUSTED_ORIGINS=https://danielmherman.com,https://www.danielmherman.com
#GS_BUCKET_NAME=danielmherman-media
#DEMO_AGENT_URL=https://<agent-service>.run.app

# --- optional ---
# Stable local SECRET_KEY across restarts (dev only; prod uses Secret Manager)
#DJANGO_SECRET_KEY=
# Agent proxy timeout seconds (default 120) and per-user daily quota (default 10)
#DEMO_AGENT_TIMEOUT=120
#DEMO_DAILY_LIMIT=10
# Dev scaffolding: serve captured fixture payloads instead of the live agent.
# Default false. Forbidden in production (startup error).
#DEMO_FIXTURE_MODE=false
# Redis channel layer for cross-process WebSocket broadcast (in-memory if unset)
#REDIS_HOST=
