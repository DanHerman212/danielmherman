{
  "name": "danielmherman",
  "private": true,
  "type": "module",
  "description": "Front-end sources for danielmherman.com (the A2UI console page). Django serves the built output from static/js/bundled/.",
  "scripts": {
    "build": "npm run build:clinical",
    "build:clinical": "vite build --config vite.clinical.config.js",
    "dev": "vite build --watch --config vite.clinical.config.js",
    "test": "node --test tests/js/*.test.mjs",
    "lint": "eslint static/js/copilot_*.js"
  },
  "dependencies": {
    "@a2ui/lit": "0.10.2",
    "@a2ui/markdown-it": "0.1.0",
    "@a2ui/web_core": "0.10.5",
    "@lit/context": "1.1.6",
    "lit": "3.2.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "eslint": "^10.13.0",
    "jsdom": "^30.1.3",
    "vite": "8.3.0"
  }
}
